# 复制为 backend/.env 后按需修改。.env 已在 .gitignore 中，不会进版本库。

# ---- LLM ----
# auto          = 有 API Key 就用真实模型，没有就自动回退 mock（推荐，开箱即用）
# mock          = 强制用假模型，不消耗额度，纯前端/链路调试用
# openai_compat = 强制用 OpenAI 兼容接口
LLM_PROVIDER=auto

# DeepSeek 示例；换成通义/硅基流动/OpenAI 只需改 base_url 与 model
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=120

# 部分厂商不支持 stream_options.include_usage（会导致拿不到 token 统计），
# 若开流时报 400，把这个改成 false
LLM_INCLUDE_USAGE=true

# ---- 数据库 ----
# 对应 docker-compose.yml 里配的账号密码
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent_rag

# ---- 向量模型 ----
# 本地跑（fastembed / ONNX）。可用模型和维度对照表在 app/embedding.py 的 KNOWN_DIMS。
#
# ⚠ 换模型 = 换维度 = 必须同步改三处：
#      1. 这里（或 app/embedding.py 的默认值）
#      2. db/init/001_init.sql 里的 vector(N)
#      3. 然后 docker compose down -v && up -d，再重新入库
#   改完用这个命令自检三处是否一致：
#      .venv\Scripts\python -m app.embedding
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 国内直连 HuggingFace 不通，必须走镜像。这两行在 app/embedding.py 里也有默认值，
# 这里列出来是为了让"为什么需要镜像"这件事可见。
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1

# ---- 服务 ----
# 逗号分隔；前端 Vite 默认跑在 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 可观测 ----
TRACE_ENABLED=true
